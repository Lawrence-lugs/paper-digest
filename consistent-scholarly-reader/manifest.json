{
  "manifest_version": 3,
  "name": "Consistent Scholarly Reader",
  "version": "0.1.0",
  "description": "Distraction-free reading mode for academic HTML papers (arXiv, IEEE, Nature, ACM, Science) with a moveable reading mark and citation hover peek.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle reading mode",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://arxiv.org/html/*",
        "https://ar5iv.labs.arxiv.org/html/*",
        "https://ieeexplore.ieee.org/document/*",
        "https://www.nature.com/articles/*",
        "https://dl.acm.org/doi/*",
        "https://www.science.org/doi/*"
      ],
      "js": [
        "content/common.js",
        "content/parsers/arxiv.js",
        "content/parsers/ieee.js",
        "content/parsers/nature.js",
        "content/parsers/acm.js",
        "content/parsers/science.js",
        "content/parsers/index.js",
        "scholarly-reader/dist/scholarly-reader.classic.js",
        "content/render.js",
        "content/readingMark.js",
        "content/citationPeek.js",
        "content/citationSidebar.js",
        "content/inject.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
