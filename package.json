{
  "name": "paper-digest",
  "version": "0.2.0",
  "description": "Paper digest generator: static client-side web app (digest + prompt + template flows).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/lafqu/paper-digest.git"
  },
  "keywords": ["arxiv", "digest", "paper"],
  "author": "paper-digest",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "dompurify": "^3.2.4",
    "jsdom": "^26.0.0",
    "linkedom": "^0.18.13",
    "playwright": "^1.53.0"
  },
  "scripts": {
    "test": "node --test test/ingest/ test/pipeline/ test/app/",
    "test:ingest": "node --test test/ingest/",
    "test:pipeline": "node --test test/pipeline/",
    "test:app": "node --test test/app/",
    "lint": "node --check web/js/**/*.js",
    "sync:csr": "node scripts/sync-csr.mjs",
    "sync:vendor": "node scripts/vendor-libs.mjs"
  },
  "files": [
