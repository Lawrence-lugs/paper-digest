{
  "name": "paper-digest-monorepo",
  "version": "0.2.0",
  "description": "Paper digest monorepo: scholarly-reader library, paper-digest-app web app, consistent-scholarly-reader extension",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:sr": "npm run build -w scholarly-reader",
    "build:app": "npm run build -w paper-digest-app",
    "build:csr": "npm run build -w consistent-scholarly-reader",
    "dev": "npm run dev -w paper-digest-app",
    "test": "npm run test --workspaces --if-present",
    "sync:vendor": "node scripts/vendor-libs.mjs"
  },
  "devDependencies": {
    "playwright": "^1.53.0"
  },
  "engines": {
    "node": ">=18"
  }
}